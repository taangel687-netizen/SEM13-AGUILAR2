{
  "info": {
    "name": "Semana 13 | Biblioteca UNCP y TecnoMarket",
    "description": "Usar sobre una base inicial con populate_data.py. Tokens temporales y credenciales ficticias.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"vence\")) pm.collectionVariables.set(\"vence\", new Date(Date.now()+7*86400000).toISOString().slice(0,10));",
          "if (pm.info.requestName === \"POST libros/\") pm.collectionVariables.set(\"isbn\", \"978\"+String(Date.now()).slice(-10));",
          "if (pm.info.requestName === \"POST productos/\") pm.collectionVariables.set(\"sku\", \"TM-DEMO-\"+Date.now());"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "password",
      "value": "PracticaLocal13!"
    }
  ],
